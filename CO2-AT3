#include <systemc.h>

SC_MODULE(EmbeddedSystem)
{
    int counter;
    sc_mutex mutex;

    void thread1()
    {
        for(int i = 0; i < 5; i++)
        {
            mutex.lock();
            counter++;
            cout << "Thread 1: Counter = " << counter << endl;
            mutex.unlock();

            wait(1, SC_NS);
        }
    }

    void thread2()
    {
        for(int i = 0; i < 5; i++)
        {
            mutex.lock();
            counter++;
            cout << "Thread 2: Counter = " << counter << endl;
            mutex.unlock();

            wait(1, SC_NS);
        }
    }

    SC_CTOR(EmbeddedSystem)
    {
        counter = 0;

        SC_THREAD(thread1);
        SC_THREAD(thread2);
    }
};

int sc_main(int argc, char* argv[])
{
    EmbeddedSystem system("EmbeddedSystem");

    sc_start(10, SC_NS);

    cout << "Final Counter = " << system.counter << endl;

    return 0;
}
